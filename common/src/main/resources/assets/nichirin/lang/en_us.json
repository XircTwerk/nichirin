  "text.autoconfig.nichirin-server.option.combat.comboWindowTicks":      "Combo Window (ticks)",
  "text.autoconfig.nichirin-server.option.combat.comboWindowTicks.@Tooltip": "How long the STUNNED effect lasts on hit, i.e. how much time you have to chain your next attack.",
  "text.autoconfig.nichirin-server.option.combat.parryWindowTicks":      "Parry Window (ticks)",
  "text.autoconfig.nichirin-server.option.combat.parryWindowTicks.@Tooltip": "Ticks after raising your block that count as a perfect parry. Shorter = more skilful.",
  "text.autoconfig.nichirin-server.option.combat.enableParrySystem":     "Enable Parry System",
  "text.autoconfig.nichirin-server.option.combat.enableParrySystem.@Tooltip": "Completely toggles the parry / perfect-block mechanic on or off.",
  "text.autoconfig.nichirin-server.option.combat.staminaRegenRate":      "Stamina Regen Rate",
  "text.autoconfig.nichirin-server.option.combat.staminaRegenRate.@Tooltip": "Stamina points regenerated per second while not attacking.",
  "text.autoconfig.nichirin-server.option.combat.npcAiLevel":            "NPC AI Level",
  "text.autoconfig.nichirin-server.option.combat.npcAiLevel.@Tooltip":   "How skilfully NPCs fight (1 = clumsy and hesitant, 25 = relentless and reactive). Applies to all moveset-capable NPCs.",
  "text.autoconfig.nichirin-server.option.combat.npcDashCooldownTicks":  "NPC Dash Cooldown (ticks)",
  "text.autoconfig.nichirin-server.option.combat.npcDashCooldownTicks.@Tooltip": "Ticks an NPC waits between dashes. Higher = less dash-spam.",
  "text.autoconfig.nichirin-server.option.combat.npcMobilityCooldownTicks": "NPC Mobility Cooldown (ticks)",
  "text.autoconfig.nichirin-server.option.combat.npcMobilityCooldownTicks.@Tooltip": "Ticks an NPC waits between mobility moves used to climb to elevated targets.",
  "text.autoconfig.nichirin-server.option.combat.npcDuelHealth":         "NPC Duel Health",
  "text.autoconfig.nichirin-server.option.combat.npcDuelHealth.@Tooltip": "Health a trainer has during a formal duel (the boss-bar fight).",
  "text.autoconfig.nichirin-server.option.combat.npcDuelCooldownSeconds": "NPC Duel Cooldown (seconds)",
  "text.autoconfig.nichirin-server.option.combat.npcDuelCooldownSeconds.@Tooltip": "Seconds a trainer must recover before it can be challenged to another duel.",
  "text.autoconfig.nichirin-server.option.combat.npcPeacefulHealth":     "NPC Peaceful Health",
  "text.autoconfig.nichirin-server.option.combat.npcPeacefulHealth.@Tooltip": "Health a trainer has outside combat (also its base max health).",
  "text.autoconfig.nichirin-server.option.combat.npcDuelWinHpThreshold": "NPC Duel-Win HP Threshold",
  "text.autoconfig.nichirin-server.option.combat.npcDuelWinHpThreshold.@Tooltip": "Health a trainer is reduced to for a non-lethal spar to end (it can't be killed in a spar).",
  "text.autoconfig.nichirin-server.option.combat.npcPlayerDuelMinHealth": "Player Duel Min Health",
  "text.autoconfig.nichirin-server.option.combat.npcPlayerDuelMinHealth.@Tooltip": "Minimum health a trainer leaves a defeated opponent at instead of killing them (0.5 = half a heart).",
  "text.autoconfig.nichirin-server.option.combat.npcSelfDefenseGraceTicks": "NPC Self-Defense Grace (ticks)",
  "text.autoconfig.nichirin-server.option.combat.npcSelfDefenseGraceTicks.@Tooltip": "Ticks a provoked self-defense fight persists after the target is lost before reverting to peaceful.",

  "text.autoconfig.nichirin-server.option.damage.baseDamageMultiplier": "Base Damage Multiplier",
  "text.autoconfig.nichirin-server.option.damage.baseDamageMultiplier.@Tooltip": "Multiplies all Nichirin attack damage after the built-in balance increase.",
  "text.autoconfig.nichirin-server.option.damage.percentageDamage": "Percentage Damage",
  "text.autoconfig.nichirin-server.option.damage.percentageDamage.@Tooltip": "Converts configured attack damage into defense-bypassing maximum-health damage using damage / 300.",

  "text.autoconfig.nichirin-server.category.movement": "Movement",
  "text.autoconfig.nichirin-server.option.movement": "Movement",
  "text.autoconfig.nichirin-server.option.movement.dashForce": "Dash Force",
  "text.autoconfig.nichirin-server.option.movement.dashForce.@Tooltip": "Horizontal impulse applied by a dash. Higher = farther dashes.",
  "text.autoconfig.nichirin-server.option.movement.doubleJumpVelocity": "Double Jump Velocity",
  "text.autoconfig.nichirin-server.option.movement.doubleJumpVelocity.@Tooltip": "Upward velocity of a double jump. Higher = higher jumps.",
  "text.autoconfig.nichirin-server.option.movement.backstepDistance": "Backstep Distance",
  "text.autoconfig.nichirin-server.option.movement.backstepDistance.@Tooltip": "Maximum blocks a backstep travels.",
  "text.autoconfig.nichirin-server.option.movement.airDodgeDistance": "Air Dodge Distance",
  "text.autoconfig.nichirin-server.option.movement.airDodgeDistance.@Tooltip": "Horizontal burst distance of an air dodge.",
  "text.autoconfig.nichirin-server.option.movement.sprintMultiplier": "Sprint Multiplier",
  "text.autoconfig.nichirin-server.option.movement.sprintMultiplier.@Tooltip": "Sprint movement-speed multiplier.",

  "text.autoconfig.nichirin-server.category.blocking": "Blocking",
  "text.autoconfig.nichirin-server.option.blocking": "Blocking",
  "text.autoconfig.nichirin-server.option.blocking.blockStanceDrain": "Block Stance Drain",
  "text.autoconfig.nichirin-server.option.blocking.blockStanceDrain.@Tooltip": "Stance drained per tick while holding a block.",
  "text.autoconfig.nichirin-server.option.blocking.parryStanceCost": "Parry Stance Cost",
  "text.autoconfig.nichirin-server.option.blocking.parryStanceCost.@Tooltip": "Stance consumed by a parry attempt.",
  "text.autoconfig.nichirin-server.option.blocking.blockCooldownTicks": "Block Cooldown (ticks)",
  "text.autoconfig.nichirin-server.option.blocking.blockCooldownTicks.@Tooltip": "Ticks before you can block again after dropping guard.",
  "text.autoconfig.nichirin-server.option.blocking.earlyReleaseStunTicks": "Early Release Stun (ticks)",
  "text.autoconfig.nichirin-server.option.blocking.earlyReleaseStunTicks.@Tooltip": "Self-stun ticks for releasing a block too early.",
  "text.autoconfig.nichirin-server.option.blocking.backstabAngle": "Backstab Angle",
  "text.autoconfig.nichirin-server.option.blocking.backstabAngle.@Tooltip": "Cone half-angle (degrees) behind the defender that ignores blocking.",

  "text.autoconfig.nichirin-server.option.stamina.staminaRegenRate":      "Stamina Regen Rate",
  "text.autoconfig.nichirin-server.option.stamina.staminaRegenRate.@Tooltip": "Stamina points regenerated per second while not attacking.",
  "text.autoconfig.nichirin-server.option.stamina.lightAttackStaminaCost": "Light Attack Stamina Cost",
  "text.autoconfig.nichirin-server.option.stamina.lightAttackStaminaCost.@Tooltip": "Stamina consumed per light katana swing.",
  "text.autoconfig.nichirin-server.option.stamina.heavyAttackStaminaCost": "Heavy Attack Stamina Cost",
  "text.autoconfig.nichirin-server.option.stamina.heavyAttackStaminaCost.@Tooltip": "Stamina consumed per breathing technique use.",
  "text.autoconfig.nichirin-server.option.stamina.unlimitedStamina":       "Unlimited Stamina",
  "text.autoconfig.nichirin-server.option.stamina.unlimitedStamina.@Tooltip": "Removes stamina cost for all breathing moves. Good for creative / testing.",

  "text.autoconfig.nichirin-server.option.breathing.infiniteBreath":       "Infinite Breath",
  "text.autoconfig.nichirin-server.option.breathing.infiniteBreath.@Tooltip": "Keeps the breathing gauge full at all times.",
  "text.autoconfig.nichirin-server.option.breathing.freeBreathMoves":      "Free Breath Moves",
  "text.autoconfig.nichirin-server.option.breathing.freeBreathMoves.@Tooltip": "Breathing techniques do not consume breath.",
  "text.autoconfig.nichirin-server.option.breathing.maxBreath":            "Max Breath",
  "text.autoconfig.nichirin-server.option.breathing.maxBreath.@Tooltip":   "Maximum breathing gauge value.",
  "text.autoconfig.nichirin-server.option.breathing.breathRegenRate":      "Breath Regen Rate",
  "text.autoconfig.nichirin-server.option.breathing.breathRegenRate.@Tooltip": "Breath points regenerated each tick. Higher values refill faster.",
  "text.autoconfig.nichirin-server.option.breathing.lightAttackStaminaCost":  "Light Attack Stamina Cost",
  "text.autoconfig.nichirin-server.option.breathing.lightAttackStaminaCost.@Tooltip": "Stamina consumed per light katana swing.",
  "text.autoconfig.nichirin-server.option.breathing.heavyAttackStaminaCost":  "Heavy Attack Stamina Cost",
  "text.autoconfig.nichirin-server.option.breathing.heavyAttackStaminaCost.@Tooltip": "Stamina consumed per breathing technique use.",
  "text.autoconfig.nichirin-server.option.breathing.unlimitedStamina":         "Unlimited Stamina",
  "text.autoconfig.nichirin-server.option.breathing.unlimitedStamina.@Tooltip": "Removes stamina cost for all breathing moves. Good for creative / testing.",

  "text.autoconfig.nichirin-server.option.demon.bloodPointsOnKill":      "Blood Points per Kill",
  "text.autoconfig.nichirin-server.option.demon.bloodPointsOnKill.@Tooltip": "Blood points awarded when killing a mob with blood. (0 = no blood gain from kills)",
  "text.autoconfig.nichirin-server.option.demon.maxBloodPoints":         "Max Blood Points",
  "text.autoconfig.nichirin-server.option.demon.maxBloodPoints.@Tooltip": "Maximum blood points a demon can hold.",
  "text.autoconfig.nichirin-server.option.demon.burnInSunlight":         "Burn in Sunlight",
  "text.autoconfig.nichirin-server.option.demon.burnInSunlight.@Tooltip": "Demons take fire damage when exposed to direct sunlight.",
  "text.autoconfig.nichirin-server.option.demon.sunDamagePerSecond":     "Sun Damage per Second",
  "text.autoconfig.nichirin-server.option.demon.sunDamagePerSecond.@Tooltip": "Half-hearts of damage per second when burning in sunlight.",
  "text.autoconfig.nichirin-server.option.demon.wisteriaDamagesDemons":  "Wisteria Damages Demons",
  "text.autoconfig.nichirin-server.option.demon.wisteriaDamagesDemons.@Tooltip": "When enabled, Wisteria's Grace deals periodic poison damage to demons.",
  "text.autoconfig.nichirin-server.option.demon.bloodDrainEnabled":      "Blood Drain",
  "text.autoconfig.nichirin-server.option.demon.bloodDrainEnabled.@Tooltip": "Demons passively lose blood over time and die when it reaches zero.",
  "text.autoconfig.nichirin-server.option.demon.bloodDrainIntervalSeconds": "Blood Drain Interval (seconds)",
  "text.autoconfig.nichirin-server.option.demon.bloodDrainIntervalSeconds.@Tooltip": "Seconds between each blood drain tick. Higher = slower drain.",
  "text.autoconfig.nichirin-server.option.demon.peacefulModeMaxBlood": "Max Blood in Peaceful",
  "text.autoconfig.nichirin-server.option.demon.peacefulModeMaxBlood.@Tooltip": "Keeps demon blood filled while the world is in peaceful difficulty.",
  "text.autoconfig.nichirin-server.option.demon.demonMaxBreathPercent": "Demon Max Breath (%)",
  "text.autoconfig.nichirin-server.option.demon.demonMaxBreathPercent.@Tooltip": "Percent of the normal maximum breath gauge demons can store.",
  "text.autoconfig.nichirin-server.option.demon.removeDemonOnDeath": "Remove Demon on Death",
  "text.autoconfig.nichirin-server.option.demon.removeDemonOnDeath.@Tooltip": "When enabled, dying as a demon removes demon status on respawn.",

  "text.autoconfig.nichirin-server.category.killRewards": "Kill Rewards",
  "text.autoconfig.nichirin-server.option.bloodMoon.enabled":               "Enable Blood Moon",
  "text.autoconfig.nichirin-server.option.bloodMoon.enabled.@Tooltip":      "Enables the blood moon event. When active, demons receive combat buffs and spawn more frequently.",
  "text.autoconfig.nichirin-server.option.bloodMoon.chancePerNight":        "Blood Moon Chance (1-in-N)",
  "text.autoconfig.nichirin-server.option.bloodMoon.chancePerNight.@Tooltip": "1-in-N chance a blood moon occurs each night. Lower values = rarer blood moons. (e.g. 50 = 2% chance per night)",
  "text.autoconfig.nichirin-server.option.bloodMoon.demonAttackBoostPercent": "Demon Attack Boost (%)",
  "text.autoconfig.nichirin-server.option.bloodMoon.demonAttackBoostPercent.@Tooltip": "Percent increase to demon attack damage during a blood moon.",
  "text.autoconfig.nichirin-server.option.bloodMoon.demonSpeedBoostPercent": "Demon Speed Boost (%)",
  "text.autoconfig.nichirin-server.option.bloodMoon.demonSpeedBoostPercent.@Tooltip": "Percent increase to demon movement speed during a blood moon.",
  "text.autoconfig.nichirin-server.option.bloodMoon.demonSpawnBoostPercent": "Demon Spawn Boost (%)",
  "text.autoconfig.nichirin-server.option.bloodMoon.demonSpawnBoostPercent.@Tooltip": "Extra spawn weight added to demons during a blood moon.",

  "text.autoconfig.nichirin-server.option.moveInterrupts.fireDamageInterruptsMoves": "Fire Damage Interrupts Moves",
  "text.autoconfig.nichirin-server.option.moveInterrupts.fireDamageInterruptsMoves.@Tooltip": "Fire, lava, and burning damage can stop move windups early.",
  "text.autoconfig.nichirin-server.option.moveInterrupts.fallDamageInterruptsMoves": "Fall Damage Interrupts Moves",
  "text.autoconfig.nichirin-server.option.moveInterrupts.fallDamageInterruptsMoves.@Tooltip": "Fall damage can stop move windups early.",
  "text.autoconfig.nichirin-server.option.moveInterrupts.projectileDamageInterruptsMoves": "Projectile Damage Interrupts Moves",
  "text.autoconfig.nichirin-server.option.moveInterrupts.projectileDamageInterruptsMoves.@Tooltip": "Arrow, trident, and other projectile damage can stop move windups early.",
  "text.autoconfig.nichirin-server.option.moveInterrupts.explosionDamageInterruptsMoves": "Explosion Damage Interrupts Moves",
  "text.autoconfig.nichirin-server.option.moveInterrupts.explosionDamageInterruptsMoves.@Tooltip": "Explosion damage can stop move windups early.",
  "text.autoconfig.nichirin-server.option.moveInterrupts.magicDamageInterruptsMoves": "Magic Damage Interrupts Moves",
  "text.autoconfig.nichirin-server.option.moveInterrupts.magicDamageInterruptsMoves.@Tooltip": "Magic and indirect magic damage can stop move windups early.",
  "text.autoconfig.nichirin-server.option.moveInterrupts.drowningDamageInterruptsMoves": "Drowning Damage Interrupts Moves",
  "text.autoconfig.nichirin-server.option.moveInterrupts.drowningDamageInterruptsMoves.@Tooltip": "Drowning damage can stop move windups early.",
  "text.autoconfig.nichirin-server.option.moveInterrupts.starvationDamageInterruptsMoves": "Starvation Damage Interrupts Moves",
  "text.autoconfig.nichirin-server.option.moveInterrupts.starvationDamageInterruptsMoves.@Tooltip": "Starvation damage can stop move windups early.",

  "text.autoconfig.nichirin-server.option.killRewards.healOnKillPlayer":              "Heal on Kill (Player)",
  "text.autoconfig.nichirin-server.option.killRewards.healOnKillPlayer.@Tooltip":    "Restore health when killing another player.",
  "text.autoconfig.nichirin-server.option.killRewards.healOnKillPlayerAsMaxHealth":  "Full Heal on Player Kill",
  "text.autoconfig.nichirin-server.option.killRewards.healOnKillPlayerAsMaxHealth.@Tooltip": "If enabled, killing a player restores you to full health instead of the fixed amount.",
  "text.autoconfig.nichirin-server.option.killRewards.healOnKillPlayerAmount":       "Player Kill Heal Amount",
  "text.autoconfig.nichirin-server.option.killRewards.healOnKillPlayerAmount.@Tooltip": "Half-hearts restored when killing a player (used if Full Heal is off).",
  "text.autoconfig.nichirin-server.option.killRewards.healOnKillMob":                "Heal on Kill (Mob)",
  "text.autoconfig.nichirin-server.option.killRewards.healOnKillMob.@Tooltip":       "Restore health when killing any non-player entity.",
  "text.autoconfig.nichirin-server.option.killRewards.healOnKillMobAmount":          "Mob Kill Heal Amount",
  "text.autoconfig.nichirin-server.option.killRewards.healOnKillMobAmount.@Tooltip": "Half-hearts restored when killing a mob.",
  "text.autoconfig.nichirin-server.option.killRewards.resetCooldownsOnKill":         "Reset Cooldowns on Kill",
  "text.autoconfig.nichirin-server.option.killRewards.resetCooldownsOnKill.@Tooltip": "Clears all move cooldowns whenever you land a kill.",
  "text.autoconfig.nichirin-server.option.killRewards.resetStaminaOnKill":           "Reset Stamina on Kill",
  "text.autoconfig.nichirin-server.option.killRewards.resetStaminaOnKill.@Tooltip":  "Fully restores stamina whenever you land a kill.",
  "text.autoconfig.nichirin-server.option.killRewards.resetBreathOnKill":            "Reset Breath on Kill",
  "text.autoconfig.nichirin-server.option.killRewards.resetBreathOnKill.@Tooltip":   "Fully restores breathing gauge whenever you land a kill.",
  "text.autoconfig.nichirin-server.option.killRewards.resetStanceOnKill":            "Reset Stance on Kill",
  "text.autoconfig.nichirin-server.option.killRewards.resetStanceOnKill.@Tooltip":   "Fully restores stance whenever you land a kill.",

  "text.autoconfig.nichirin-server.option.perks.enablePerks": "Enable Perks",
  "text.autoconfig.nichirin-server.option.perks.enablePerks.@Tooltip": "Allows players to discover, equip, and benefit from perks.",
  "text.autoconfig.nichirin-server.option.perks.enableFlawSystem": "Enable Flaw System",
  "text.autoconfig.nichirin-server.option.perks.enableFlawSystem.@Tooltip": "Allows flaws to be assigned and used alongside perks.",
  "text.autoconfig.nichirin-server.option.perks.maxFlaws": "Max Flaws",
  "text.autoconfig.nichirin-server.option.perks.maxFlaws.@Tooltip": "Maximum number of flaws a player can have active.",
  "text.autoconfig.nichirin-server.option.perks.maxTier": "Max Perk Tier",
  "text.autoconfig.nichirin-server.option.perks.maxTier.@Tooltip": "Highest perk tier players can upgrade to. 0 = Common, 4 = Legendary.",
  "text.autoconfig.nichirin-server.option.perks.disabledPerkIds": "Disabled Perk IDs",
  "text.autoconfig.nichirin-server.option.perks.disabledPerkIds.@Tooltip": "Perk IDs that cannot be discovered, equipped, or upgraded.",

  "text.autoconfig.nichirin_client.title": "Breath of Nichirin — Client",
  "text.autoconfig.nichirin_client.category.visual": "Visual (Client-Only)",
  "text.autoconfig.nichirin_client.option.visual": "Visual",
  "text.autoconfig.nichirin_client.option.visual.enableBreathingAuraParticles": "Breathing Aura Particles",
  "text.autoconfig.nichirin_client.option.visual.enableBreathingAuraParticles.@Tooltip": "Show wisp particles around players with an active breathing style. This only affects your own game.",
  "text.autoconfig.nichirin_client.option.visual.enableHitParticles":    "Hit Impact Particles",
  "text.autoconfig.nichirin_client.option.visual.enableHitParticles.@Tooltip": "Show blood splat and spark particles when attacks connect. This only affects your own game.",
  "text.autoconfig.nichirin_client.option.visual.enableParrySparks":     "Parry Spark Effects",
  "text.autoconfig.nichirin_client.option.visual.enableParrySparks.@Tooltip": "Play the burst of sparks and flash when a perfect parry is triggered. This only affects your own game.",
  "text.autoconfig.nichirin_client.option.visual.enableAfterimages":     "Afterimage Trails",
  "text.autoconfig.nichirin_client.option.visual.enableAfterimages.@Tooltip": "Show the ghost/afterimage trails during fast dashes like Thunderclap and Flash. Turn OFF if fast moves lag your game. This only affects your own game."
}
